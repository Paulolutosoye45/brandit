# Copy this file to .env.local, then fill in what you need. Nothing here is a real secret.

# ---------- Mode ----------
# true  = demo: sign-in codes and Google accounts appear on screen, payments are simulated,
#         demo staff exist (admin@brandit.test, PIN 1234). Good for trying it out and showing people.
# false = live. Set this before real customers. Outside development, demo mode is OFF unless you set true,
#         and it refuses to run against a hosted database.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Security (live mode) ----------
# Long random string: openssl rand -hex 32
SESSION_SECRET=
# Protects /api/cron/sweep (runs every 5 minutes on Vercel via vercel.json)
CRON_SECRET=
# The first admin, created on first start in live mode. The PIN is 6 to 12 digits, not a run like 123456.
ADMIN_EMAIL=
ADMIN_PIN=

# ---------- Docker Compose (the one-server setup) ----------
# Your domain, without https://, and a password for the database. Only used by docker-compose.yml.
DOMAIN=
POSTGRES_PASSWORD=

# ---------- Database ----------
# Empty = built-in local Postgres (PGlite) in .data/pg. Fine for trying it out, not for real orders.
# Live: any Postgres, for example Supabase (Project settings > Database > Connection string).
DATABASE_URL=
DATABASE_SSL=true
# Connections each server copy may open. Default 10, or 4 on Vercel (which runs many short-lived copies). Lower it if the database says "too many connections".
DATABASE_POOL_MAX=

# ---------- Sign in with Google ----------
# Google Cloud Console > APIs and Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Sign-in codes by email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=Brandit <hello@your-domain.ng>

# ---------- Sign-in codes and fallback messages by SMS (Termii) ----------
SMS_API_KEY=
SMS_SENDER_ID=Brandit

# ---------- Payments (Paystack) ----------
# Webhook URL to add in Paystack: {NEXT_PUBLIC_APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=

# ---------- Artwork files ----------
# Local disk by default (needs a host with a persistent disk).
UPLOAD_DIR=.data/uploads
# Or any S3-compatible bucket (Cloudflare R2, AWS S3). Use this on hosts without a persistent disk.
# For R2 the endpoint is https://<account id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---------- Rate limits and visitor addresses ----------
# How many proxies of yours sit between a visitor and the server. Render alone is usually 2, and 3 with Cloudflare's
# orange cloud on. Check it on the console Setup page ("Your address"). Leave empty to use the first address.
TRUSTED_PROXY_HOPS=

# ---------- Alerts and scheduling ----------
# Your production lead's number (with country code). They are texted when a job is at risk of being late.
ALERT_PHONE=
# The five-minute check (late orders, unpaid-order reminders, referral rewards, clean-up) runs inside the server by default. Set false only if you call /api/cron/sweep yourself.
INTERNAL_CRON=true

# ---------- WhatsApp ----------
# The number customers can message, with country code and no plus: 2348031234567
NEXT_PUBLIC_WHATSAPP=
# Shown on the Contact page, the Terms and the Privacy Policy when set. Leave empty to hide them: we never invent contact details.
# These are built into the site, so after changing them rebuild (Render redeploys by itself).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# Order updates through the WhatsApp Business Platform (Meta Cloud API)
# Every template Meta must approve is listed, ready to paste, in WHATSAPP_TEMPLATES.md (rebuild it with: npm run templates:whatsapp).
# Until a template is approved, that message goes by SMS instead. Pidgin templates (names ending _pcm) are optional.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Legal pages ----------
# The Terms, Privacy and Refunds pages carry a "Draft for legal review" notice until a Nigerian lawyer has been through them.
# Set this to yes once they have, and the notice disappears. Read when the server starts.
LEGAL_REVIEWED=

# ---------- Brandit Studio (AI designs) ----------
# Studio stays CLOSED on a live site until at least one picture-maker key below is set. Keys are never shown in the console.
# Prices, model names and the order engines are tried in are settings (Console, Studio, Settings), so a vendor renaming a model is not a deploy.
# Run scripts/studio-bakeoff.ts with your keys first to see which engine to put first.
# Recraft: free sketches and Standard designs, cut-outs, vector files. https://www.recraft.ai (API)
RECRAFT_API_KEY=
# Black Forest Labs (FLUX): a second opinion and a fallback. https://docs.bfl.ai
BFL_API_KEY=
# Google (Gemini "Nano Banana" image models): Premium designs. https://aistudio.google.com
GEMINI_API_KEY=
# OpenAI: Premium fallback, and the image-safety check on finished designs. Without it, the console review queue is the safeguard.
OPENAI_API_KEY=
# fal.ai: the Topaz enlarger for big prints. Without it Studio enlarges on the Brandit server (fine for small prints).
FAL_KEY=
# How many designs are made at the same moment on this server (default 2). Raise it only if your server has spare memory.
STUDIO_CONCURRENCY=
# Fonts for Studio are shipped in studio-assets/fonts. Set this only to read them from somewhere else.
STUDIO_FONT_DIR=
